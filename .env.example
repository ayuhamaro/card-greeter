# ─── Grounding ───────────────────────────────────────────
GEMINI_API_KEY=AIxxxxxxxxxxx
GEMINI_GROUNDING_MODEL=gemini-2.5-flash
COLLABORATION_HINTS_FILE=/var/www/card-greeter/config/collaboration_hints.yaml

# ─── AI Vision ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 支援 Structured Outputs 的模型皆可使用
# 建議：gpt-5.5 | gpt-5.5-2026-04-23
OPENAI_VISION_MODEL=gpt-5.5

# ─── Google OAuth2 (for Login + Gmail Send) ───────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Session ──────────────────────────────────────────────
# 生成指令：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your_random_secret_key_here

# Session Token 加密金鑰（Fernet）
# 生成指令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPT_KEY=your_fernet_key_here

# ─── 寄件人資訊 ────────────────────────────────────────────
SENDER_NAME=你的姓名
SENDER_BIO_FILE=/var/www/card-greeter/config/sender_bio.html
# Line ID（選填）；Pub/Sub 事件驅動服務用此值透過 Line OA 通知寄件人
SENDER_LINE_ID=your_line_id

# ─── 存取控制 ──────────────────────────────────────────────
ALLOWED_EMAIL=your.email@gmail.com

# ─── Google Cloud Pub/Sub ─────────────────────────────────
# 設為 true 時，/api/send 寄信成功後會在背景將名片資訊發布至 Pub/Sub
# 設為 false（預設）時，下方三個欄位可不填
PUBSUB_ENABLED=false

# Service Account JSON 檔案絕對路徑（建議放在專案目錄的平行目錄，避免 Nginx 意外暴露）
# 所需角色：roles/pubsub.publisher
# 建議路徑：/var/www/secrets/card-greeter-pubsub-sa.json
# 建立指令：sudo mkdir -p /var/www/secrets && chmod 700 /var/www/secrets
#           chmod 600 /var/www/secrets/card-greeter-pubsub-sa.json
GOOGLE_SA_CREDENTIALS_FILE=/var/www/secrets/card-greeter-pubsub-sa.json
PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_ID=card-greeter-events

# ─── 應用設定 ──────────────────────────────────────────────
# 本機開發用 http，部署時改 https
APP_BASE_URL=http://localhost:8000

# 郵件 Footer 的 GitHub Repo 連結
GITHUB_REPO_URL=https://github.com/ayuhamaro/card-greeter